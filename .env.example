# Google Gemini (Generative Language API) for intent parsing. Free tier, no card:
# get a key at https://aistudio.google.com/apikey . Model is env-driven; defaults
# to gemini-flash-lite-latest in code if GEMINI_MODEL is unset.
#
# Two things matter in this value, and both are failure modes we have hit:
#
#  1. Prefer the moving `-latest` alias over a pinned version. A pinned model
#     Google retires answers 404 — `gemini-2.5-flash` and `gemini-2.5-flash-lite`
#     both do now — and because intent parsing falls back to the offline regex
#     parser on ANY error, the app keeps replying, just much worse.
#  2. Prefer flash-LITE on the free tier. Free-tier `gemini-flash-latest` is
#     capped at 20 requests PER DAY per model; request 21 is a 429, into that
#     same silent fallback. Flash-lite has real headroom and is ~8x faster
#     here. On a paid key, plain `gemini-flash-latest` is the stronger parser.
#
# Either way, check the parse path is actually live rather than assuming:
#   grep -c intent.gemini_failed_fallback_local   # should stay at 0
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=

# Solana / Aegis.
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_COMMITMENT=confirmed
# Cluster label for Explorer links (devnet | testnet | mainnet-beta).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Read-only RPC for token research. Tokens are mainnet mints, so this stays on
# mainnet-beta even when transfers run on devnet. Defaults to mainnet-beta if unset.
#
# The public endpoint below works, with one visible gap: it rate-limits
# `getTokenLargestAccounts` (429 "Too many requests for a specific RPC call")
# on essentially every request, while `getTokenSupply` on the same mint
# succeeds. That is why the research card's "Top 10 concentration" row reads
# "unavailable" on a default deployment — the metric is fine, the endpoint
# will not answer it. Point this at a provider RPC (Helius, QuickNode,
# Triton) and the row fills in. The card's "How this was gathered" trail
# names whichever endpoint answered, by host only, so a key in the query
# string is never rendered.
PRAXIS_RESEARCH_RPC_URL=https://api.mainnet-beta.solana.com
AEGIS_PROGRAM_ID=3z9GuipayYpAcPnjiwFkfe6gZvfSfuPZgX8djYu67Yhd

# API mode derives the policy PDA from the signed-in wallet. The owner address is
# still useful for scripts/bootstrap, but route authorization comes from the
# wallet session cookie.
AEGIS_OWNER_ADDRESS=

# Scoped agent keypair used to sign only Aegis `agent_transfer` instructions.
# Use either a path to a Solana keypair JSON file or a JSON/base58 secret value.
# Used by the in-process LocalKeypairSigner (default for local/devnet).
PRAXIS_AGENT_KEYPAIR_PATH=./keys/agent.json
PRAXIS_AGENT_KEYPAIR=

# --- Agent key custody (production) ---
# Set PRAXIS_AGENT_SIGNER_URL to move agent signing behind a remote signer
# service (the agent private key then lives only in that service, not here).
# When set, the app holds only the agent PUBLIC key + a bearer token. See
# signer/README.md for a ~$0 deploy (Oracle Cloud + Cloudflare Tunnel).
PRAXIS_AGENT_SIGNER_URL=
PRAXIS_AGENT_PUBLIC_KEY=
PRAXIS_AGENT_SIGNER_TOKEN=
# In production a raw in-process agent keypair is refused unless this is "1".
PRAXIS_ALLOW_LOCAL_AGENT_KEY=
# The configured agent key is the on-chain authority on EVERY wallet's policy,
# so a single shared key serving multiple owners means one leak can drain them
# all. In production the backend refuses to serve a wallet other than the single
# configured AEGIS_OWNER_ADDRESS under a shared key. Set this to "1" to
# explicitly accept the shared-key model (or use PRAXIS_AGENT_SIGNER_URL).
PRAXIS_ALLOW_SHARED_AGENT_KEY=
# Rotation under remote custody: only the next agent PUBLIC key is needed.
PRAXIS_NEXT_AGENT_PUBLIC_KEY=

# Optional owner keypair for server-side policy admin routes and the local demo
# bootstrap. Omit in production if owner actions are wallet-signed elsewhere.
PRAXIS_OWNER_KEYPAIR_PATH=
PRAXIS_OWNER_KEYPAIR=

# Required for rotate-agent/re-enable. Must be different from PRAXIS_AGENT_KEYPAIR;
# the backend refuses to restore the current key by default.
PRAXIS_NEXT_AGENT_KEYPAIR_PATH=
PRAXIS_NEXT_AGENT_KEYPAIR=

# Public site origin (no trailing slash). Used as metadataBase for absolute
# Open Graph / Twitter share image URLs. Set to your production domain on Vercel,
# e.g. https://praxis.yourdomain.com. Falls back to http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=

# Frontend provider switch.
# Production deploys should use `api`. `mock` is for local development only
# unless NEXT_PUBLIC_PRAXIS_ALLOW_MOCK=1 is deliberately set at build time.
NEXT_PUBLIC_PRAXIS_PROVIDER=api
NEXT_PUBLIC_PRAXIS_ALLOW_MOCK=0

# Required for durable wallet sessions in production. Use a random 32+ character
# value. Local development falls back to an in-memory secret that rotates on
# process restart.
PRAXIS_SESSION_SECRET=

# State backend for API-mode threads, proposals, and rejected activity.
#   fs       - filesystem (local/devnet; not durable across serverless instances)
#   postgres - managed Postgres (production; durable across instances)
# Defaults to `postgres` when a database URL is set, otherwise `fs`.
PRAXIS_STATE_BACKEND=fs

# Local/devnet filesystem state directory (used when PRAXIS_STATE_BACKEND=fs).
PRAXIS_STATE_DIR=.praxis/state

# Managed Postgres connection string (used when PRAXIS_STATE_BACKEND=postgres).
# Neon (Vercel Marketplace) or any Postgres-compatible URL works. The schema is
# created lazily on first use; see server/provider/migrations/0001_init.sql.
# POSTGRES_URL / PRAXIS_DATABASE_URL are also accepted.
# Local dev: Docker Postgres from compose.yml (host port 5433 — brew owns 5432):
#   DATABASE_URL=postgresql://praxis:praxis@localhost:5433/praxis
# Localhost URLs automatically use the node-postgres driver; remote URLs use
# Neon. Override explicitly with PRAXIS_PG_DRIVER=pg|neon.
DATABASE_URL=
PRAXIS_PG_DRIVER=

# Bound external dependencies so the app fails cleanly instead of hanging.
PRAXIS_LLM_TIMEOUT_MS=15000
PRAXIS_RPC_READ_TIMEOUT_MS=8000
PRAXIS_INDEXER_TIMEOUT_MS=4000

# Structured-log verbosity: debug | info | warn | error.
# Defaults to info in production, debug otherwise.
PRAXIS_LOG_LEVEL=

# Rate limiter backend: memory | redis.
#   memory - process-local (default; fine for a single instance / local dev)
#   redis  - Upstash-REST when UPSTASH_* creds are set, else native RESP via REDIS_URL
# Defaults to redis when Upstash/KV credentials are present, else memory.
# Local dev: Docker Redis from compose.yml (REDIS_URL always wins when set).
#
# The same Redis also backs single-use wallet sign-in nonces. Without it,
# nonces are single-use per INSTANCE only, so a captured challenge signature
# can be replayed against a different serverless instance within its 5-minute
# TTL. Configure Redis for any multi-instance deployment. (The nonce store
# fails CLOSED — if a configured Redis is unreachable, sign-in is refused
# rather than silently degraded.)
PRAXIS_RATE_LIMITER=
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional local deterministic parser for demos without a Gemini key.
PRAXIS_LOCAL_INTENT=0
PRAXIS_DEMO_USE_LLM=0

# Optional off-chain address book. Labels have no signing power. In production,
# leaving this empty keeps the address book empty (no seeded contacts) unless
# PRAXIS_ALLOW_DEMO_DATA=1. Populate it with your own saved contacts as needed:
#   PRAXIS_ADDRESS_BOOK=[{"label":"ops","name":"Ops Wallet","address":"<base58>","note":"..."}]
PRAXIS_ALLOW_DEMO_DATA=0
PRAXIS_ADDRESS_BOOK=

# Optional indexer endpoint for research. `{mint}` is replaced at runtime.
PRAXIS_INDEXER_URL=https://api.dexscreener.com/latest/dex/tokens/{mint}

# --- PreStocks stock universe (Stocklana; flagged off by default) ---
# Set PRAXIS_STOCKS_ENABLED=1 to merge the 8 verified PreStocks pre-IPO mints
# (ANDURIL, ANTHROPIC, FIGUREAI, KALSHI, NEURALINK, OPENAI, POLYMARKET, SPACEX)
# into the token list. Bounty exclusivity: never add non-PreStocks pre-IPO
# mints in the submission branch. Stock decimals default to 6 until the
# funded-RPC spike confirms per-mint values (see docs/PRESTOCKS-SPIKE.md).
PRAXIS_STOCKS_ENABLED=0
PRAXIS_PRESTOCKS_API_URL=https://prestocks.com/api/prestocks
PRAXIS_PRESTOCKS_TIMEOUT_MS=5000

# Confirmed per-mint decimals, e.g. {"OPENAI":9,"SPACEX":6}. The PreStocks API
# does not report decimals, and decimals are the exponent on every amount the
# agent moves — a wrong one moves the wrong quantity. Anything omitted here is
# read from the chain (PRAXIS_RESEARCH_RPC_URL, where the mints live) and
# cached; if that read fails, the agent refuses the buy instead of guessing.
# Set this only for values you have actually verified.
PRAXIS_STOCK_DECIMALS=

# Symbol -> mint overrides for a demo cluster, e.g. {"OPENAI":"<devnet mint>"}.
# The real PreStocks mints are MAINNET-ONLY, so a devnet deployment must point
# at Token-2022 mirror mints created on that cluster:
#   bun run praxis:setup-devnet-stocks   # creates them, prints this block
# The app labels a mirrored universe in the UI — a demo must not look like it
# is moving real pre-IPO tokens.
PRAXIS_STOCK_MINTS=

# Skip the pre-flight check that a token mint is one Aegis can actually move
# (classic SPL Token, present on the transfer cluster). Only for offline tests
# and demos — in production this is how an unsignable proposal reaches a user.
PRAXIS_ALLOW_UNVERIFIED_MINTS=

# --- Scheduled recurring buys (DCA) ---------------------------------------
# Required for recurring buys to actually fire. `/api/cron/stocks` accepts
# `Authorization: Bearer $CRON_SECRET` and fans out over every wallet with
# stored state, emitting one proposal per due schedule (it never signs).
#
# Without this set the job endpoint is DISABLED, not open — and a schedule
# then only fires when its owner personally hits the endpoint from a signed-in
# browser. If you enable stocks, set this too or recurring buys are a promise
# the deployment cannot keep.
#
# Vercel Cron sends this header automatically from the project's CRON_SECRET;
# the schedule itself lives in vercel.json. Minimum 16 characters — generate
# with: openssl rand -base64 32
CRON_SECRET=

# UTC hour the scheduled-buy cron fires. MUST match the cron expression in
# vercel.json (default `0 9 * * *` → 9). Schedules anchor their fire time to
# this hour: firing is one daily tick, so a schedule timed after the tick
# would not be due until the next day — "every Monday" would fire Tuesday.
PRAXIS_SCHEDULE_HOUR_UTC=9
# Optional display/order filter (comma-separated known symbols, e.g.
# PRAXIS_STOCK_UNIVERSE=OPENAI,SPACEX). Empty means the full universe.
PRAXIS_STOCK_UNIVERSE=
