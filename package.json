{
  "name": "praxis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && cd sdk && tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test": "bun test --env-file=/dev/null server app/api components signer sdk",
    "test:watch": "bun test --env-file=/dev/null --watch server app/api components signer sdk",
    "signer": "bun signer/index.ts",
    "aegis:build": "cd aegis && NO_DNA=1 anchor build",
    "aegis:test": "cd aegis && NO_DNA=1 anchor build && NO_DNA=1 cargo test --test enforcement -- --nocapture",
    "praxis:demo": "bun scripts/praxis-demo.ts",
    "praxis:moneyshots": "bun scripts/moneyshots.ts",
    "praxis:swapcheck": "bun scripts/swapcheck.ts",
    "praxis:setup-token-accounts": "bun scripts/setup-token-accounts.ts",
    "praxis:tokencheck": "bun scripts/tokencheck.ts",
    "praxis:stockscheck": "bun scripts/stockscheck.ts",
    "praxis:stocksgate": "bun scripts/stocksgate.ts",
    "praxis:stocks-dca": "bun scripts/stocks-dca.ts",
    "praxis:setup-devnet-stocks": "bun scripts/setup-devnet-stocks.ts",
    "praxis:stocksbuycheck": "bun scripts/stocksbuycheck.ts",
    "praxis:localcheck": "bun scripts/localcheck.ts",
    "praxis:reenablecheck": "bun scripts/reenable-smoke.ts",
    "praxis:reenablecycles": "bun scripts/reenable-multicycle.ts",
    "praxis:policycheck": "bun scripts/policychange-smoke.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@solana/web3.js": "^1.98.4",
    "@tabler/icons-react": "^3.44.0",
    "bs58": "^6.0.0",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "postcss": "^8.5.15",
    "uuid": "^11.1.1"
  }
}
